	<message name="rechercherEtablissementRequest">
		<part name="RE_Security" element="wsse:Security"/>
		<part name="RE_ContexteLPS" element="ctxlps:ContexteLPS"/>
		<part name="RE_MessageID" element="wsa:MessageID"/>
		<part name="parameters" element="reqinfopsfiness:EXPOLPSTRANSP_REQINFOPSFINESS"/>
	</message>
	<message name="rechercherEtablissementResponse">
		<part name="parameters" element="infopsstructure:EXPOLPSTRANSP_INFOPSSTRUCTURE"/>
	</message>
	<message name="rechercherPrescripteurPraticienRequest">
		<part name="RPP_Security" element="wsse:Security"/>
		<part name="RPP_ContexteLPS" element="ctxlps:ContexteLPS"/>
		<part name="RPP_MessageID" element="wsa:MessageID"/>
