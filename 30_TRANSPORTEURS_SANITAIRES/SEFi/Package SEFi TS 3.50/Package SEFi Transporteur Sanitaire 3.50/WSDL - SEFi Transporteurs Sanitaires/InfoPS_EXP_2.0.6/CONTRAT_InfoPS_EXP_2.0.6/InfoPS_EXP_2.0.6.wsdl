				<wsoap12:header message="s1:rechercherDonneesTransporteurRequest" part="RDT_MessageID" use="literal"/>
				<wsoap12:body parts="parameters" use="literal"/>
			</input>
			<output>
				<wsoap12:body use="literal"/>
			</output>
		</operation>
	</binding>
	<service name="InfoPSIR">
		<port name="InfoPSIRWSPort" binding="s1:InfoPSIRWSPortBinding">
			<wsoap12:address location="https://qualiflps.services-ps.ameli.fr/lps"/>
		</port>
