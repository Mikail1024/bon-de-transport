			<xsd:import schemaLocation="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd" namespace="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"/>
			<xsd:import schemaLocation="http://www.w3.org/2005/08/addressing/ws-addr.xsd" namespace="http://www.w3.org/2005/08/addressing"/>
			<xsd:import namespace="urn:siram:lps:ctxlps" schemaLocation="xsd/CTX/ROOT_ctxlps_CTXLPS_V01_00.xsd"/>
			<xsd:import namespace="urn:ir:expolps_reqinfopsfiness" schemaLocation="xsd/InfoPS/ROOT_expolps_reqinfopsfiness_EXPOLPSTRANSP_REQINFOPSFINESS_V00_03.xsd"/>
			<xsd:import namespace="urn:ir:expolps_infopsstructure" schemaLocation="xsd/InfoPS/ROOT_expolps_infopsstructure_EXPOLPSTRANSP_INFOPSSTRUCTURE_V00_02.xsd"/>
